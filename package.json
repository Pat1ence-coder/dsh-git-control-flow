{
  "name": "@local/dsh-git-control-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Generative Git workflow card inside the DSH conversation",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check": "for f in index.js client.js lib/git/*.mjs lib/flow/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs && node test/client-smoke.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
